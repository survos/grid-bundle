{# Keep the controller on a stable wrapper: DataTables moves the table during init/destroy. #}
{% if condition %}
    {% set columns = this.normalizedColumns %}
    {% set remoteColumns = [] %}
    {% if remoteUrl %}
        {% for c in columns %}
            {% set remoteColumns = remoteColumns|merge([{name: c.name, title: this.trans ? c.title|trans : c.title, sortable: c.sortable, searchable: c.searchable}]) %}
        {% endfor %}
    {% endif %}
    <div {{ this.stimulusController ? stimulus_controller(this.stimulusController, {
        extensions: this.extensions,
        options: this.options ?: null,
        locale: this.locale,
        useDatatables: this.useDatatables,
        search: this.search,
        info: this.info,
        dom: this.dom,
        pageLength: this.pageLength,
        scrollY: this.scrollY,
        remoteUrl: this.remoteUrl,
        columns: remoteUrl ? remoteColumns : null,
    }) }}>
        <table {{ this.tableId ? 'id="%s"'|format(this.tableId)|raw }}
            class="table table-striped {{ this.tableClasses }}"
            {{ this.stimulusController ? stimulus_target(this.stimulusController, 'table') }}>
        {% if not remoteUrl %}
        <thead>
        <tr>
            {% for c in columns %}
                <th class="{{ c.inSearchPane ? 'in-search-pane' }}" {{ c.width ? 'style="width: %s"'|format(c.width)|raw }}>
                    {{ this.trans ? c.title|trans : c.title }}
                </th>
            {% endfor %}
        </tr>
        </thead>
        <tbody>
        {% for idx, row in data %}
            <tr class="align-top">
                {% for c in columns %}
                    <td>
                        {# use a different block than the column name when set, so the same block can be reused across columns #}
                        {% set templateName = c.twigTemplate|default(c.name) %}

                        {% if block(templateName) is defined %}
                            {% set blockParams = {field_name: c.name, row: row, idx: idx, column: c, c: c} %}
                            {% if rowAlias %}
                                {% set blockParams = setAttribute(blockParams, rowAlias, row) %}
                            {% endif %}
                            {% with blockParams %}
                                {{ block(templateName) }}
                            {% endwith %}
                        {% else %}
                            {% if c.twigTemplate %}
                                <span class="text-danger">{{ templateName }} is not defined.</span>
                            {% endif %}
                            {% set label = attribute(row, c.name)|default() %}
                            {% if label is iterable %}
                                {% set label = label|length %}
                            {% endif %}
                            {% if c.translateValue %}
                                {% set label = c.domain ? label|trans(domain=c.domain) : label|trans %}
                            {% endif %}
                            {% if c.route %}
                                <a href="{{ path(c.route, row.rp) }}">{{ label }}</a>
                            {% else %}
                                {{ label }}
                            {% endif %}
                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
        {% else %}
            {% if not this.useDatatables %}
                <tr><td colspan="{{ columns|length }}">no records found</td></tr>
            {% endif %}
        {% endfor %}
        </tbody>
        {% endif %}
        </table>
    </div>
{% endif %}
