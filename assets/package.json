{
  "name": "@survos/grid",
  "description": "the basics: render a plain in-memory or single-fetch table with DataTables.net (v3), no ApiPlatform required",
  "license": "MIT",
  "version": "2.0.0",
  "symfony": {
    "controllers": {
      "grid": {
        "main": "src/controllers/grid_controller.js",
        "webpackMode": "eager",
        "fetch": "lazy",
        "enabled": true,
        "autoimport": {
          "datatables.net-bs5/css/dataTables.bootstrap5.css": true
        }
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.2.2",
      "datatables.net-bs5": "3.0.1",
      "datatables.net-bs5/css/dataTables.bootstrap5.css": "3.0.1"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.2.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2"
  },
  "dependencies": {
    "datatables.net-bs5": "3.0.1"
  }
}
